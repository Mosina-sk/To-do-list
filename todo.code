from tkinter import *
from tkinter import messagebox

# Create main window
root = Tk()
root.title("To-Do List Application")
root.geometry("400x500")
root.config(bg="navyblue")

# List to store tasks
tasks = []

# ---------------- Functions ---------------- #

def add_task():
    task = task_entry.get()

    if task != "":
        tasks.append(task)
        task_listbox.insert(END, task)
        task_entry.delete(0, END)
    else:
        messagebox.showwarning("Warning", "Please enter a task.")

def delete_task():
    try:
        selected = task_listbox.curselection()[0]
        task_listbox.delete(selected)
        tasks.pop(selected)
    except:
        messagebox.showwarning("Warning", "Please select a task.")

def clear_tasks():
    if messagebox.askyesno("Confirm", "Do you want to clear all tasks?"):
        task_listbox.delete(0, END)
        tasks.clear()

# ---------------- GUI ---------------- #

title = Label(root, text="To-Do List", font=("Arial", 18, "bold"),
              bg="lightblue")
title.pack(pady=10)

task_entry = Entry(root, width=30, font=("Arial", 14))
task_entry.pack(pady=10)

add_btn = Button(root, text="Add Task", width=15,
                 command=add_task, bg="green", fg="white")
add_btn.pack(pady=5)

task_listbox = Listbox(root, width=40, height=12,
                       font=("Arial", 12), selectbackground="purple")
task_listbox.pack(pady=10)

delete_btn = Button(root, text="Delete Task", width=15,
                    command=delete_task, bg="red", fg="white")
delete_btn.pack(pady=5)

clear_btn = Button(root, text="Clear All", width=15,
                   command=clear_tasks, bg="brown", fg="white")
clear_btn.pack(pady=5)

# Run application
root.mainloop()